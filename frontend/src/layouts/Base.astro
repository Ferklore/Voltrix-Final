---
import '../styles/global.css'
import { categorias } from '../lib/api.js'
import BotonCarrito from '../components/BotonCarrito.jsx'
import MenuUsuario from '../components/MenuUsuario.jsx'

const { titulo, descripcion = 'Microcontroladores, sensores y displays con envío a todo México.', sinSidebar = false } = Astro.props
const cats = await categorias()
const ruta = Astro.url.pathname
const q = ruta === '/buscar' ? Astro.url.searchParams.get('q') ?? '' : ''
// Resalta Ofertas / Más vendidos en el sidebar cuando la búsqueda es exactamente esa.
const vista = ruta === '/buscar' && !q && !Astro.url.searchParams.get('categoria')
  ? Astro.url.searchParams.get('ofertas') ? 'ofertas' : Astro.url.searchParams.get('orden') === 'MAS_VENDIDOS' ? 'vendidos' : ''
  : ''
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{titulo ? `${titulo} · Voltrix` : 'Voltrix · Componentes electrónicos'}</title>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <div class="app-layout">
      <header class="topbar">
        <a class="topbar-logo" href="/">VOLTRIX</a>
        <form class="buscador" action="/buscar" method="get" role="search">
          <input type="search" name="q" value={q} placeholder="Buscar componentes…" aria-label="Buscar productos" maxlength="100" />
          <button type="submit" aria-label="Buscar">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </form>
        <nav class="topbar-nav" aria-label="Principal">
          <MenuUsuario client:load />
          <BotonCarrito client:load />
        </nav>
      </header>

      <div class="app-body">
        {!sinSidebar && (
          <aside class="sidebar">
            <h2>Categorías</h2>
            <ul>
              <li><a href="/" aria-current={ruta === '/' ? 'page' : undefined}>Todos</a></li>
              <li><a href="/buscar?ofertas=1" aria-current={vista === 'ofertas' ? 'page' : undefined}>Ofertas</a></li>
              <li><a href="/buscar?orden=MAS_VENDIDOS" aria-current={vista === 'vendidos' ? 'page' : undefined}>Más vendidos</a></li>
              <li><a href="/kit" aria-current={ruta === '/kit' ? 'page' : undefined}>Arma tu kit</a></li>
              {cats.map((c) => (
                <li>
                  <a href={`/categoria/${c.id}`} aria-current={ruta === `/categoria/${c.id}` ? 'page' : undefined}>
                    {c.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
        <main id="contenido" class="app-main"><slot /></main>
      </div>

      <footer class="footer">
        <div class="footer-top">
          <div class="footer-col">
            <p class="footer-brand">VOLTRIX</p>
            <p>Componentes electrónicos para makers, estudiantes y talleres.</p>
          </div>
          <div class="footer-col">
            <h2>Categorías</h2>
            <ul>{cats.map((c) => <li><a href={`/categoria/${c.id}`}>{c.nombre}</a></li>)}</ul>
          </div>
          <div class="footer-col">
            <h2>Tu cuenta</h2>
            <ul>
              <li><a href="/cuenta">Mis pedidos</a></li>
              <li><a href="/deseos">Lista de deseos</a></li>
              <li><a href="/carrito">Carrito</a></li>
              <li><a href="/registro">Crear cuenta</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Voltrix</p>
        </div>
      </footer>
    </div>
  </body>
</html>
