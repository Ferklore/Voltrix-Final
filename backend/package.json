{
  "name": "voltrix-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "crear-admin": "node --env-file-if-exists=.env scripts/crear-admin.mjs",
    "migrar": "node --env-file-if-exists=.env scripts/migrar.mjs",
    "mcp": "node --env-file-if-exists=.env scripts/mcp-stdio.mjs",
    "validar": "node scripts/validar.mjs",
    "test:unit": "node --test test/cfdi.test.js test/correo.test.js test/mongo.test.js test/kits.test.js test/google.test.js test/modo-prueba.test.js",
    "test:e2e": "node --test test/api.test.js test/subscripciones.test.js test/mcp.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/schema": "^10.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.1",
    "jose": "6.2.15",
    "mongodb": "7.8.0",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "ws": "^8.22.1",
    "xmllint-wasm": "5.3.0",
    "zod": "4.6.7"
  }
}
