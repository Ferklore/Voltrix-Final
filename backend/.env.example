# Copia este archivo como .env y pon tu URL de Neon.
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=verify-full

# Puerto del backend
PORT=4000
# Dirección del frontend que tiene permiso de llamar a la API (CORS).
# Varias separadas por coma.
FRONTEND_URL=http://localhost:4321

# --- Pagos (credenciales de PRUEBA / sandbox) ---
# La tienda es de prueba: con PAGOS_MODO=prueba (o sin la variable) el backend
# solo habla con el sandbox de PayPal y, si Mercado Pago llegara a aprobar un
# pago real, lo rechaza y lo reembolsa. Solo con PAGOS_MODO=produccion cobra de verdad.
PAGOS_MODO=prueba
# Si una variable falta, ese método simplemente no aparece en el checkout.

# PayPal: developer.paypal.com > Apps & Credentials (modo Sandbox) > Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox. En producción: https://api-m.paypal.com
PAYPAL_API=https://api-m.sandbox.paypal.com
PAYPAL_MONEDA=MXN

# Mercado Pago (Checkout API): mercadopago.com.mx/developers > tu aplicación >
# Credenciales > Prueba. Se necesitan las dos: la Public Key la usa el Card
# Payment Brick en el navegador y el Access Token cobra desde el backend.
# Es normal que empiecen con APP_USR- y sean de un usuario de prueba "TestApp-…".
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# El webhook de Mercado Pago (Orders API) se configura en el panel de la
# aplicación: Webhooks > evento "Order" > https://<tu-backend>/webhooks/mercadopago

# --- Prefactura CFDI (Anexo 20 del SAT) ---
# Emisor de las prefacturas. Si no se ponen, se usa el RFC de pruebas del SAT.
CFDI_EMISOR_RFC=EKU9003173C9
CFDI_EMISOR_NOMBRE=ESCUELA KEMPER URGATE
# 601 = General de Ley Personas Morales (ver src/cfdi/catalogos.js)
CFDI_EMISOR_REGIMEN=601
# Código postal donde se expide (LugarExpedicion)
CFDI_LUGAR_EXPEDICION=44100
CFDI_SERIE=V

# --- Correo (Resend) ---
# resend.com > API Keys. Sin esta variable los correos NO se envían: se
# muestran en la consola del backend (sirve para probar en local).
RESEND_API_KEY=
# Sin dominio verificado en Resend: remitente onboarding@resend.dev y solo
# llega al correo de tu cuenta de Resend. Con dominio: Voltrix <tienda@tudominio.com>
CORREO_REMITENTE=Voltrix <onboarding@resend.dev>
# Dirección pública de la tienda para los enlaces de los correos
# (si no se pone, la primera de FRONTEND_URL).
TIENDA_URL=http://localhost:4321
# Piezas o menos con las que se avisa de stock bajo a los admins.
STOCK_MINIMO=5

# --- MongoDB (fichas técnicas, reseñas, historial de pedidos y bitácora) ---
# Atlas: mongodb.com/atlas > crea un cluster gratis (M0) > Database Access (usuario
# y contraseña) > Network Access (agrega tu IP o 0.0.0.0/0 para el servidor) >
# Connect > Drivers > copia la URL. Sin esta variable la tienda funciona igual,
# pero sin esas cuatro funciones.
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=voltrix


# --- Login con Google ---
# console.cloud.google.com > APIs y servicios > Credenciales > Crear ID de
# cliente de OAuth > Aplicación web. En "Orígenes autorizados de JavaScript"
# agrega http://localhost:4321, http://localhost y la URL de tu tienda.
# Solo se usa el Client ID (es público); no hace falta el secreto.


# --- Cloudinary (imágenes de productos y respaldo de prefacturas) ---
# cloudinary.com > Dashboard > "API environment variable". Formato:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Carpeta raíz dentro de tu cuenta de Cloudinary
CLOUDINARY_CARPETA=voltrix

# --- Mouser Search API (importar componentes al catálogo) ---
# mouser.com > My Account > APIs > Search API (gratis, ~1000 búsquedas al día).
MOUSER_API_KEY=
# Precio sugerido = USD x tipo de cambio x margen x IVA (el admin lo puede cambiar)
MOUSER_TIPO_CAMBIO=18.5
MOUSER_MARGEN=1.35
